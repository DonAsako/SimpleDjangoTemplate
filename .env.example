# Copy to .env and fill in. Real environment variables override these.
# `.env` is git-ignored — never commit real secrets.

# Which settings module to load. Defaults are wired in manage.py (development)
# DJANGO_SETTINGS_MODULE=project.settings.development

# --- Core -------------------------------------------------------------------

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# Never enable in production. Ignored by production settings (always False there).
DEBUG=True

# Comma-separated. Required in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------------------------

# Single connection URL. Leave unset to use a local SQLite file (dev default).
# Postgres example:
# DATABASE_URL=postgres://user:password@localhost:5432/mydb

# --- Admin ------------------------------------------------------------------

# Path prefix for the admin site (e.g. set to something obscure in production).
ADMIN_URL=admin

# --- Localization (optional) ------------------------------------------------

# LANGUAGE_CODE=en-us
# TIME_ZONE=UTC

# --- Production only ---------------------------------------------------------

# Comma-separated origins trusted for CSRF (must include scheme).
# Defaults to https://<each ALLOWED_HOSTS entry>.
# CSRF_TRUSTED_ORIGINS=https://example.com

# Redirect all HTTP to HTTPS (default True). Set False if the proxy handles it.
# SECURE_SSL_REDIRECT=True

# HSTS max-age in seconds (default 31536000 = 1 year).
# SECURE_HSTS_SECONDS=31536000
